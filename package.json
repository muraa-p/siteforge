{
  "name": "siteforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:deploy": "npm run build && npm run gen:sample && npm run prepare:site",
    "prepare:site": "node scripts/prepare-dist.mjs",
    "gen:sample": "tsx scripts/gen-sample.ts",
    "shots": "tsx scripts/shots.ts",
    "og": "tsx scripts/og-image.ts",
    "preview": "vite preview",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.1"
  }
}
